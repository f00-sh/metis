(ql:quickload :metis :silent t)
(in-package :metis)
(boot :reset t)
(format t "clear a before: ~S~%" (ask *mind* '(clear a)))
(format t "plan: ~S~%" (plan *mind* '((clear a)) :execute nil))
(format t "plan exec: ~S~%" (plan *mind* '((clear a)) :execute t))
(format t "clear a after plan: ~S~%" (ask *mind* '(clear a)))

(boot :reset t)
(format t "~%pursue...~%")
(let ((r (pursue *mind* '((clear a)) :max-cycles 8)))
  (format t "result: ~S~%" r)
  (format t "clear a: ~S~%" (ask *mind* '(clear a)))
  (format t "goals: ~S~%" (mind-goals *mind*))
  (format t "trace:~%")
  (dolist (e (reverse (subseq (mind-trace *mind*) 0
                              (min 30 (length (mind-trace *mind*))))))
    (format t "  ~S~%" e)))
(uiop:quit 0)
