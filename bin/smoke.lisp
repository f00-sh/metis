(ql:quickload :metis :silent t)
(in-package :metis)
(boot)
(format t "~%~A~%" (mind-status *mind*))
(format t "UNIFY: ~S~%" (unify '(mortal ?x) '(mortal socrates)))
(format t "ASK mortal: ~S~%" (ask *mind* '(mortal socrates)))
(format t "ASK fly tweety: ~S~%" (ask *mind* '(can-fly tweety)))
(format t "ASK fly opus: ~S~%" (ask *mind* '(can-fly opus)))
(format t "PLAN: ~S~%" (plan *mind* '((on b c))))
(format t "SELF: ~S~%" (getf (self-model *mind*) :identity))
(uiop:quit 0)
