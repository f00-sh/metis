(ql:quickload :metis/tests :silent t)

(defun %suite-ok (suite)
  (let ((results (fiveam:run! suite)))
    (cond ((eq results t) t)
          ((eq results nil) nil)
          ((typep results 'sequence)
           (fiveam:results-status results))
          (t t))))

(let ((ok1 (%suite-ok :metis))
      (ok2 (%suite-ok :metis-production))
      (ok3 (%suite-ok :metis-bench))
      (ok4 (%suite-ok :metis-further))
      (ok5 (%suite-ok :metis-epoch))
      (ok6 (%suite-ok :metis-iface))
      (ok7 (%suite-ok :metis-nn))
      (ok8 (%suite-ok :metis-symbols))
      (ok8b (%suite-ok :metis-packs))
      (ok8c (%suite-ok :metis-seals))
      (ok8c2 (%suite-ok :metis-task-load))
      (ok8c3 (%suite-ok :metis-reason-act))
      (ok8c4 (%suite-ok :metis-chat-spine))
      (ok8d (%suite-ok :metis-install))
      (ok9 (%suite-ok :metis-frontiers))
      (ok10 (%suite-ok :metis-hybrid)))
  (format t "~&~%=== METIS 4.5 TEST SUMMARY ===~%")
  (format t "core: ~A  production: ~A  bench: ~A  further: ~A  epoch: ~A  iface: ~A  nn: ~A  symbols: ~A  packs: ~A  seals: ~A  task-load: ~A  reason-act: ~A  chat-spine: ~A  install: ~A  frontiers: ~A  hybrid: ~A~%"
          (if ok1 "PASS" "FAIL")
          (if ok2 "PASS" "FAIL")
          (if ok3 "PASS" "FAIL")
          (if ok4 "PASS" "FAIL")
          (if ok5 "PASS" "FAIL")
          (if ok6 "PASS" "FAIL")
          (if ok7 "PASS" "FAIL")
          (if ok8 "PASS" "FAIL")
          (if ok8b "PASS" "FAIL")
          (if ok8c "PASS" "FAIL")
          (if ok8c2 "PASS" "FAIL")
          (if ok8c3 "PASS" "FAIL")
          (if ok8c4 "PASS" "FAIL")
          (if ok8d "PASS" "FAIL")
          (if ok9 "PASS" "FAIL")
          (if ok10 "PASS" "FAIL"))
  (uiop:quit (if (and ok1 ok2 ok3 ok4 ok5 ok6 ok7 ok8 ok8b ok8c ok8c2 ok8c3 ok8c4 ok8d ok9 ok10) 0 1)))
