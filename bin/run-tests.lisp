(ql:quickload :metis/tests :silent t)

(defun %suite-ok (suite)
  (let ((results (fiveam:run! suite)))
    (cond ((eq results t) t)
          ((eq results nil) nil)
          ((typep results 'sequence)
           (fiveam:results-status results))
          (t t))))

(let ((ok1 (%suite-ok :metis))
      (ok2 (%suite-ok :metis-production))
      (ok3 (%suite-ok :metis-bench))
      (ok4 (%suite-ok :metis-further))
      (ok5 (%suite-ok :metis-epoch))
      (ok6 (%suite-ok :metis-iface))
      (ok7 (%suite-ok :metis-nn))
      (ok8 (%suite-ok :metis-symbols))
      (ok9 (%suite-ok :metis-frontiers)))
  (format t "~&~%=== METIS 4.2 TEST SUMMARY ===~%")
  (format t "core: ~A  production: ~A  bench: ~A  further: ~A  epoch: ~A  iface: ~A  nn: ~A  symbols: ~A  frontiers: ~A~%"
          (if ok1 "PASS" "FAIL")
          (if ok2 "PASS" "FAIL")
          (if ok3 "PASS" "FAIL")
          (if ok4 "PASS" "FAIL")
          (if ok5 "PASS" "FAIL")
          (if ok6 "PASS" "FAIL")
          (if ok7 "PASS" "FAIL")
          (if ok8 "PASS" "FAIL")
          (if ok9 "PASS" "FAIL"))
  (uiop:quit (if (and ok1 ok2 ok3 ok4 ok5 ok6 ok7 ok8 ok9) 0 1)))
