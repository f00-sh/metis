(:metis-pack 1
 :facts
 ((capability about "English metalanguage and grammar notes")
  (nl-concept "noun" "A noun is a word that names a person, place, thing, or idea. Examples: river, algorithm, kindness, Metis.")
  (nl-concept "verb" "A verb shows action or being: load, compute, is, become. Tense and agreement attach to verbs.")
  (nl-concept "adjective" "An adjective describes a noun: sealed package, dual-facet symbol, pure-CL model.")
  (nl-concept "adverb" "An adverb modifies verbs/adjectives: carefully, very, offline.")
  (nl-concept "pronoun" "Pronouns replace nouns: I, you, we, they, it, who, which.")
  (nl-concept "preposition" "A preposition relates a noun to something else: in, on, under, with, about.")
  (nl-concept "conjunction" "A conjunction joins words or clauses: and, but, or, because.")
  (nl-concept "article" "Articles mark nouns: a, an, the.")
  (nl-concept "grammar" "Grammar is the system of rules for combining words into meaningful phrases and sentences.")
  (nl-concept "syntax" "Syntax is how words are ordered and structured in phrases and sentences.")
  (nl-concept "semantics" "Semantics is meaning — what words and sentences are about.")
  (nl-concept "pragmatics" "Pragmatics is meaning in context — what speakers do with language.")
  (nl-concept "morpheme" "A morpheme is a smallest meaningful unit (un-, -ed, cat).")
  (nl-concept "phoneme" "A phoneme is a contrastive sound unit in a language.")
  (nl-concept "dialect" "A dialect is a regional or social variety of a language.")
  (nl-concept "register" "Register is style level: formal, informal, technical, slang.")
  (word-def "metaphor" "a figure of speech comparing unlike things without like/as")
  (word-def "simile" "a comparison using like or as")
  (word-def "idiom" "a phrase whose meaning is not literal from its parts")
  (word-def "synonym" "a word with a similar meaning")
  (word-def "antonym" "a word with an opposite meaning")
  (domain-def "lang-en-about" "about" "metalanguage and English grammar concepts"))
 :corpus-inline
 ("About facet: what is a noun / verb / grammar / semantics."
  "Stack on natural-language; pairs with dict-en-lite for word definitions."
  "Slang packs add register without replacing core English."))
