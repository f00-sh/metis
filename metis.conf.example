;; Metis production configuration (copy to metis.conf or set METIS_CONFIG)
(:log-level :info)
(:safe-eval t)
(:tool-shell-enabled nil)
(:api-port 7433)
(:api-address "127.0.0.1")
(:daemon-interval 0.25)
(:max-plan-depth 24)
(:max-proof-depth 64)
(:verbose t)
(:trace-reasoning t)
;; LLM: leave unset to auto-enable when XAI_API_KEY / METIS_LLM_API_KEY / ~/.metis/llm.key is present.
;; Default provider is SpaceXAI/xAI (https://api.x.ai/v1). Override if needed:
;; (:llm-base-url "https://api.x.ai/v1")
;; (:llm-model "grok-3")
;; (:llm-api-key "xai-…")   ; prefer env / keyfile over conf for secrets
